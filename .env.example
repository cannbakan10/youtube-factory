# ============================================
# YouTube Factory - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (Required)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (Required)
# Get from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API Key (Optional - fallback for videos)
# Get from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# ElevenLabs API Key (Required for TTS)
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Tavily API Key (Required for research)
# Get from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI API Key (Optional - fallback for AI)
# Get from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# YouTube Data API Key (Optional - for viral analyzer)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your project
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# YouTube OAuth Credentials (Optional - for auto-upload)
# Create OAuth 2.0 credentials in Google Cloud Console
# Download as client_secrets.json to project root
# YT_CLIENT_ID=your_client_id
# YT_CLIENT_SECRET=your_client_secret

# X (Twitter) API Credentials
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_BEARER_TOKEN=your_bearer_token
